# Plantilla de variables. Cópiala a .env.local y rellénala. No subas nunca valores reales al repositorio.

# URL pública de la aplicación (se usa en los enlaces de invitación y recuperación).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API. La clave publishable es pública por diseño (solo autenticación).
# (NEXT_PUBLIC_SUPABASE_ANON_KEY sigue funcionando como alternativa heredada.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Entrar con Google no necesita variables aquí: el ID de cliente y el secreto de Google se pegan en Supabase
# (Authentication → Providers → Google). Ver README.

# PRIVADAS: solo en el servidor. Nunca con prefijo NEXT_PUBLIC_.
# Clave secret: se usa para enviar invitaciones y para firmar las subidas y lecturas de las
# creatividades (bucket privado `creatives` de Supabase Storage).
# (SUPABASE_SERVICE_ROLE_KEY sigue funcionando como alternativa heredada.)
SUPABASE_SECRET_KEY=
# Cadena de conexión a Postgres (Supabase → Connect → Transaction pooler, puerto 6543).
DATABASE_URL=

# Demo local con datos ficticios (PGlite en memoria). Ignora Supabase por completo.
# No la actives en producción.
# WORKSPACE_DEMO=1
# Opcional: carpeta donde conservar los datos de la demo entre reinicios.
# WORKSPACE_DEMO_DIR=.demo-data
# (Los archivos subidos en la demo se guardan en `<WORKSPACE_DEMO_DIR>-uploads`, o en la carpeta temporal del sistema.)
